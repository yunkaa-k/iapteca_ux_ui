# Copy/setup locally with scripts/setup-local.ps1; do not put real secrets here.
MONGODB_URI=mongodb://iapteca_app:replace_me@localhost:27017/iapteca?replicaSet=rs0&authSource=iapteca
MONGO_INITDB_ROOT_USERNAME=iapteca_admin
MONGO_INITDB_ROOT_PASSWORD=replace_me_before_start
MONGO_APP_USERNAME=iapteca_app
MONGO_APP_PASSWORD=replace_me_before_start
